    {
      "id": "view-functions-content",
      "type": "text",
      "x": 120,
      "y": 1840,
      "width": 460,
      "height": 160,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "roundness": null,
      "seed": 142,
      "groupIds": [],
      "frameId": null,
      "boundElements": [],
      "locked": false,
      "text": "BONDINGCURVE:\n  • getReserves() → (realNative, realToken)\n  • getVirtualReserves() → (vNative, vToken)\n  • getCurrentPrice() → price (scaled 1e18)\n  • calculateMarketCap() → marketCap\n  • getATHPrice() → (price, timestamp)\n  • getATHMarketCap() → (marketCap, timestamp)\n  • getLock() → bool (graduation status)\n  • getIsListing() → bool (DEX listed)",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "version": 1,
      "versionNonce": 142,
      "index": "b1Q",
      "isDeleted": false,
      "updated": 1768800000000,
      "link": null,
      "containerId": null,
      "originalText": "BONDINGCURVE:\n  • getReserves() → (realNative, realToken)\n  • getVirtualReserves() → (vNative, vToken)\n  • getCurrentPrice() → price (scaled 1e18)\n  • calculateMarketCap() → marketCap\n  • getATHPrice() → (price, timestamp)\n  • getATHMarketCap() → (marketCap, timestamp)\n  • getLock() → bool (graduation status)\n  • getIsListing() → bool (DEX listed)",
      "autoResize": true,
      "lineHeight": 1.4285714285714286
    },
