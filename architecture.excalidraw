    },
    {
      "id": "mapping-content",
      "type": "text",
      "x": 120,
      "y": 2120,
      "width": 980,
      "height": 240,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "roundness": null,
      "seed": 152,
      "groupIds": [],
      "frameId": null,
      "boundElements": [],
      "locked": false,
      "text": "CreateCurve → Token (insert new token record with metadata, creator, addresses)\n             → BlockchainEvent (store raw event data)\n\nBuy/Sell    → Transaction (insert trade record with amounts, price)\n             → Holder (update buyer/seller balance)\n             → Token (increment tradeCount)\n\nSync        → Token (update realNativeReserve, realTokenReserve, virtualNativeReserve, virtualTokenReserve, currentPrice)\n             → PriceHistory (insert new price snapshot)\n\nNewATHPrice → Token (update athPrice, athPriceTimestamp)\nNewATHMcap  → Token (update athMarketCap, athMarketCapTimestamp)\n\nLock        → Token (set isLocked = true)\nListing     → Token (set isListed = true, uniswapV3Pool = pool address, listingTimestamp)\n\nCreatorFeesAccumulated → CreatorFee (update accumulatedAmount, pendingAmount)\nCreatorFeesClaimed     → CreatorFee (update claimedAmount, pendingAmount, lastClaimAt)",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "version": 1,
      "versionNonce": 152,
      "index": "b1V",
      "isDeleted": false,
      "updated": 1768800000000,
      "link": null,
      "containerId": null,
