    {
      "id": "events-content",
      "type": "text",
      "x": 115,
      "y": 1200,
      "width": 350,
      "height": 260,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "roundness": null,
      "seed": 104,
      "groupIds": [],
      "frameId": null,
      "boundElements": [],
      "locked": false,
      "text": "FROM CORE.SOL:\n• CreateCurve(creator, curve, token, URI, name, symbol)\n• Buy(token, to, amountIn, amountOut, price, ts)\n• Sell(token, from, to, amountIn, amountOut, price, ts)\n\nFROM BONDINGCURVE.SOL:\n• Sync(token, realNative, realToken, vNative, vToken, price)\n• Lock(token) - Graduation triggered\n• Listing(curve, token, pool, amount0, amount1, liquidity)\n• NewATHPrice(token, newPrice, timestamp)\n• NewATHMarketCap(token, newMarketCap, timestamp)\n\nFROM FACTORY.SOL:\n• CreatorFeesAccumulated(creator, amount, total)\n• CreatorFeesClaimed(creator, amount)",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "version": 1,
      "versionNonce": 104,
      "index": "b14",
      "isDeleted": false,
      "updated": 1768800000000,
      "link": null,
      "containerId": null,
      "originalText": "FROM CORE.SOL:\n• CreateCurve(creator, curve, token, URI, name, symbol)\n• Buy(token, to, amountIn, amountOut, price, ts)\n• Sell(token, from, to, amountIn, amountOut, price, ts)\n\nFROM BONDINGCURVE.SOL:\n• Sync(token, realNative, realToken, vNative, vToken, price)\n• Lock(token) - Graduation triggered\n• Listing(curve, token, pool, amount0, amount1, liquidity)\n• NewATHPrice(token, newPrice, timestamp)\n• NewATHMarketCap(token, newMarketCap, timestamp)\n\nFROM FACTORY.SOL:\n• CreatorFeesAccumulated(creator, amount, total)\n• CreatorFeesClaimed(creator, amount)",
      "autoResize": true,
      "lineHeight": 1.5384615384615385
    },
