{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020"],
    "declaration": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitAny": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@core/*": ["libs/core/src/*"],
      "@core": ["libs/core/src/index"],
      "@domain/*": ["libs/domain/src/*"],
      "@domain": ["libs/domain/src/index"],
      "@application/*": ["libs/application/src/*"],
      "@application": ["libs/application/src/index"],
      "@infrastructure/*": ["libs/infrastructure/src/*"],
      "@infrastructure": ["libs/infrastructure/src/index"],
      "@presentation/*": ["libs/presentation/src/*"],
      "@presentation": ["libs/presentation/src/index"],
      "@shared/*": ["libs/shared/src/*"],
      "@shared": ["libs/shared/src/index"]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/__tests__/**"
  ]
}
