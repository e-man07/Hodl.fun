# Application
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hodlfun

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Blockchain - Push Chain Testnet
PUSH_RPC_URL=https://evm.rpc-testnet-donut-node1.push.org/
PUSH_RPC_URL_ALT=https://evm.rpc-testnet-donut-node2.push.org/
CHAIN_ID=42101
CHAIN_NAME=Push Chain Testnet

# Smart Contracts (Deployed addresses - to be filled after deployment)
CORE_ADDRESS=0x
BONDING_CURVE_FACTORY_ADDRESS=0x
WNAT_ADDRESS=0x

# IPFS / Pinata
PINATA_JWT=your_pinata_jwt_here

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=86400

# Logging
LOG_LEVEL=debug

# Bull Queue
BULL_REDIS_URL=redis://localhost:6379

# Monitoring (Optional)
SENTRY_DSN=
PROMETHEUS_ENABLED=false
