// Prisma schema for Hodl.fun Token Launchpad Backend

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// TOKENS TABLE
// Stores static token information
// ============================================
model Token {
  id              String   @id @default(cuid())
  address         String   @unique @db.VarChar(42)
  curveAddress    String?  @db.VarChar(42) // Bonding curve contract address
  name            String   @db.VarChar(100)
  symbol          String   @db.VarChar(20)
  creator         String   @db.VarChar(42)
  decimals        Int      @default(18)
  totalSupply     String   @db.VarChar(78) // BigInt as string
  reserveRatio    Int      // Percentage (0-100)
  metadataURI     String?  @db.Text
  metadataCache   Json?    // Cached IPFS metadata
  logoURL         String?  @db.Text
  description     String?  @db.Text
  socialLinks     Json?    // Twitter, Telegram, Website
  createdAt       DateTime @default(now())
  blockNumber     BigInt
  transactionHash String   @db.VarChar(66)
  tradingEnabled  Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  // Bonding curve reserves (for AMM calculations)
  realNativeReserve String @default("0") @db.VarChar(78) // Real reserve of native token (ETH)
  realTokenReserve String @default("0") @db.VarChar(78) // Real reserve of launchpad tokens
  virtualNativeReserve String @default("0") @db.VarChar(78) // Virtual reserve for price discovery
  virtualTokenReserve String @default("0") @db.VarChar(78) // Virtual reserve for price discovery

  // Real-time metrics (updated by workers)
  currentPrice    String   @default("0") @db.VarChar(78) // Current token price in wei (as string for BigInt precision)
  marketCap       String   @default("0") @db.VarChar(78) // Current market cap in wei (as string for BigInt precision)
  volume24h       String   @default("0") @db.VarChar(78) // 24h trading volume in native currency (BigInt as string)
  volume7d        String   @default("0") @db.VarChar(78) // 7d trading volume in native currency (BigInt as string)
  volumeTotal     String   @default("0") @db.VarChar(78) // Total trading volume in native currency (BigInt as string)
  priceChange24h  Float    @default(0) // 24h price change percentage
  currentSupply   String   @default("0") @db.VarChar(78) // Current circulating supply
  holderCount     Int      @default(0) // Cached holder count
  tradeCount      Int      @default(0) // Total number of trades
  metricsUpdatedAt DateTime? // Last time metrics were updated

  // All-Time High (ATH) tracking
  athPrice        String   @default("0") @db.VarChar(78) // All-time high price
  athMarketCap    String   @default("0") @db.VarChar(78) // All-time high market cap
  athPriceTimestamp DateTime? // When ATH price was reached
  athMarketCapTimestamp DateTime? // When ATH market cap was reached

  // Graduation state
  isLocked        Boolean  @default(false) // Token locked for graduation process
  isListed        Boolean  @default(false) // Token listed on full DEX (Uniswap V3)
  uniswapV3Pool   String?  @db.VarChar(42) // Uniswap V3 pool address after graduation
  listingTimestamp DateTime? // When token was listed on DEX
  graduationThreshold String @default("1000000000000000000000000") @db.VarChar(78) // 1,000,000 PUSH (1M) in wei

  // Relations
  holders      Holder[]
  transactions Transaction[]
  positions    UserPosition[]

  // Indexes
  @@index([address])
  @@index([curveAddress])
  @@index([creator])
  @@index([createdAt(sort: Desc)])
  @@index([tradingEnabled])
  @@index([tradingEnabled, createdAt(sort: Desc)]) // For marketplace filtering
  @@index([creator, createdAt(sort: Desc)]) // For user created tokens
  @@index([marketCap(sort: Desc)]) // For sorting by market cap
  @@index([volume24h(sort: Desc)]) // For trending/volume sorting
  @@index([metricsUpdatedAt]) // For worker prioritization
  @@index([isLocked])
  @@index([isListed])
  @@map("tokens")
}

// ============================================
// HOLDERS TABLE
// Tracks token holder balances
// ============================================
model Holder {
  id             String   @id @default(cuid())
  tokenAddress   String   @db.VarChar(42)
  holderAddress  String   @db.VarChar(42)
  balance        String   @db.VarChar(78) // BigInt as string
  firstAcquired  DateTime @default(now())
  lastUpdated    DateTime @updatedAt

  // Relations
  token Token @relation(fields: [tokenAddress], references: [address], onDelete: Cascade)

  // Unique constraint
  @@unique([tokenAddress, holderAddress])
  @@index([holderAddress])
  @@index([tokenAddress])
  @@index([tokenAddress, balance(sort: Desc)], map: "holders_token_balance_desc_idx") // For top holders query
  @@index([tokenAddress, balance], map: "holders_token_balance_idx") // Added for count queries with balance filter
  @@map("holders")
}

// ============================================
// TRANSACTIONS TABLE
// Stores all buy/sell/create transactions
// ============================================
model Transaction {
  hash           String   @id @db.VarChar(66)
  userAddress    String   @db.VarChar(42)
  tokenAddress   String   @db.VarChar(42)
  type           TransactionType
  amountIn       String   @db.VarChar(78) // BigInt as string
  amountOut      String   @db.VarChar(78) // BigInt as string
  price          Float    // Price at transaction time
  timestamp      DateTime @default(now())
  blockNumber    BigInt
  status         TransactionStatus @default(SUCCESS)
  gasUsed        String?  @db.VarChar(78)
  gasPrice       String?  @db.VarChar(78)

  // Relations
  token Token @relation(fields: [tokenAddress], references: [address], onDelete: Cascade)

  // Indexes
  @@index([userAddress, timestamp(sort: Desc)])
  @@index([tokenAddress, timestamp(sort: Desc)])
  @@index([timestamp(sort: Desc)])
  @@index([type])
  @@map("transactions")
}

// ============================================
// USER PORTFOLIOS TABLE
// Aggregated user holdings with PnL tracking
// ============================================
model UserPortfolio {
  id                  String   @id @default(cuid())
  userId              String   @unique @db.VarChar(42) // Maps to user wallet address
  holdings            String   @default("[]") @db.Text // JSON array of holdings (for Map structure)
  totalInvestedPUSH   String   @default("0") @db.VarChar(78) // Total invested amount
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Indexes
  @@index([userId])
  @@map("user_portfolios")
}

// ============================================
// USER POSITIONS TABLE (per-token holdings)
// Tracks individual token positions for users
// ============================================
model UserPosition {
  id              String   @id @default(cuid())
  userAddress     String   @db.VarChar(42)
  tokenAddress    String   @db.VarChar(42)
  balance         String   @db.VarChar(78) // Current balance
  averagePrice    String   @db.VarChar(78) // Average buy price (as string for precision)
  totalInvested   String   @db.VarChar(78) // Total invested
  totalSold       String   @db.VarChar(78) // Total sold
  realizedPnL     String   @db.VarChar(78) // Realized profit/loss
  unrealizedPnL   String   @db.VarChar(78) // Unrealized profit/loss
  firstPurchase   DateTime @default(now())
  lastUpdated     DateTime @updatedAt

  // Relations
  token Token @relation(fields: [tokenAddress], references: [address], onDelete: Cascade)

  // Unique constraint
  @@unique([userAddress, tokenAddress])
  @@index([userAddress])
  @@index([tokenAddress])
  @@map("user_positions")
}

// ============================================
// IPFS CACHE TABLE
// Caches IPFS metadata to reduce gateway calls
// ============================================
model IPFSCache {
  ipfsHash      String   @id @db.VarChar(100)
  contentType   String   @db.VarChar(50) // json, image, etc.
  data          Json?    // JSON metadata
  blobURL       String?  @db.Text // For images, CDN URL
  pinned        Boolean  @default(false)
  uploadedAt    DateTime @default(now())
  lastAccessed  DateTime @updatedAt
  expiresAt     DateTime? // Optional TTL

  @@index([lastAccessed])
  @@map("ipfs_cache")
}

// ============================================
// MARKET STATS TABLE
// Daily aggregated market statistics
// ============================================
model MarketStat {
  date            DateTime @id @db.Date
  totalTokens     Int      @default(0)
  totalMarketCap  Float    @default(0)
  totalVolume24h  Float    @default(0)
  totalHolders    Int      @default(0)
  newTokens24h    Int      @default(0)
  trades24h       Int      @default(0)
  activeUsers24h  Int      @default(0)
  avgTokenPrice   Float    @default(0)

  @@index([date(sort: Desc)])
  @@map("market_stats")
}

// ============================================
// PRICE HISTORY TABLE
// Tracks token price over time for charts
// ============================================
model PriceHistory {
  id              String   @id @default(cuid())
  tokenAddress    String   @db.VarChar(42)
  price           String   @db.VarChar(78) // Price in wei (BigInt as string)
  marketCap       String   @db.VarChar(78) // Market cap in wei (BigInt as string)
  volume          String   @default("0") @db.VarChar(78) // Volume for this period
  timestamp       DateTime @default(now())
  blockNumber     BigInt

  // OHLCV data for candles (optional, populated by aggregation)
  open            String?  @db.VarChar(78)
  high            String?  @db.VarChar(78)
  low             String?  @db.VarChar(78)
  close           String?  @db.VarChar(78)
  interval        String?  @db.VarChar(10) // '1m', '5m', '15m', '1h', '4h', '1d'

  @@index([tokenAddress, timestamp(sort: Desc)])
  @@index([tokenAddress, interval, timestamp(sort: Desc)])
  @@index([blockNumber])
  @@map("price_history")
}

// ============================================
// CREATOR FEES TABLE
// Tracks accumulated and claimed creator fees
// ============================================
model CreatorFee {
  id                String   @id @default(cuid())
  creatorAddress    String   @db.VarChar(42)
  tokenAddress      String   @db.VarChar(42)
  accumulatedAmount String   @default("0") @db.VarChar(78) // Total accumulated fees (BigInt as string)
  claimedAmount     String   @default("0") @db.VarChar(78) // Total claimed fees (BigInt as string)
  pendingAmount     String   @default("0") @db.VarChar(78) // Pending = accumulated - claimed
  lastClaimAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([creatorAddress, tokenAddress])
  @@index([creatorAddress])
  @@index([tokenAddress])
  @@index([creatorAddress, accumulatedAmount(sort: Desc)])
  @@map("creator_fees")
}

// ============================================
// BLOCKCHAIN EVENTS TABLE
// Stores all indexed blockchain events for querying
// ============================================
model BlockchainEvent {
  id              String   @id @default(cuid())
  eventType       String   @db.VarChar(50) // CreateCurve, Buy, Sell, Sync, Lock, Listing, etc.
  tokenAddress    String?  @db.VarChar(42)
  userAddress     String?  @db.VarChar(42) // Creator, buyer, or seller
  data            Json     // Event-specific data
  transactionHash String   @db.VarChar(66)
  blockNumber     BigInt
  logIndex        Int
  timestamp       DateTime @default(now())

  @@unique([transactionHash, logIndex])
  @@index([eventType, timestamp(sort: Desc)])
  @@index([tokenAddress, eventType, timestamp(sort: Desc)])
  @@index([userAddress, eventType, timestamp(sort: Desc)])
  @@index([blockNumber])
  @@map("blockchain_events")
}

// ============================================
// INDEXER STATE TABLE
// Tracks indexer checkpoint for recovery
// ============================================
model IndexerState {
  id                  String   @id @default("main")
  lastProcessedBlock  BigInt   @default(0)
  lastProcessedAt     DateTime @default(now())
  chainId             Int      @default(42101)
  isRunning           Boolean  @default(false)
  errorCount          Int      @default(0)
  lastError           String?  @db.Text
  lastErrorAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("indexer_state")
}

// ============================================
// ENUMS
// ============================================

enum TransactionType {
  BUY
  SELL
  CREATE
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

// ============================================
// FEE VAULT SNAPSHOTS TABLE
// Tracks FeeVault balance changes over time
// Since FeeVault doesn't emit events, we poll and store snapshots
// ============================================
model FeeVaultSnapshot {
  id                String   @id @default(cuid())
  totalAssets       String   @db.VarChar(78) // Total WPUSH assets in vault
  totalSupply       String   @db.VarChar(78) // Total vault shares
  pricePerShare     String   @db.VarChar(78) // Price per share (scaled by 1e18)
  blockNumber       BigInt   // Block number when snapshot was taken
  timestamp         DateTime @default(now())

  // Calculated delta from previous snapshot
  assetsDelta       String?  @db.VarChar(78) // Change in assets since last snapshot

  @@index([timestamp(sort: Desc)])
  @@index([blockNumber(sort: Desc)])
  @@map("fee_vault_snapshots")
}
