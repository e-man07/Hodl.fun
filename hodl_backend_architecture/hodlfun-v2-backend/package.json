{
  "name": "hodlfun-v2-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Hodl.fun V2 Backend - Token Launchpad Platform",
  "scripts": {
    "build": "turbo run build",
    "build:api": "pnpm --filter api run build",
    "build:websocket": "pnpm --filter websocket run build",
    "build:indexer": "pnpm --filter indexer run build",
    "build:worker": "pnpm --filter worker run build",
    "start:dev": "turbo run start:dev",
    "start:dev:api": "pnpm --filter api run start:dev",
    "start:dev:websocket": "pnpm --filter websocket run start:dev",
    "start:dev:indexer": "pnpm --filter indexer run start:dev",
    "start:dev:worker": "pnpm --filter worker run start:dev",
    "start:prod:api": "pnpm --filter api run start:prod",
    "start:prod:websocket": "pnpm --filter websocket run start:prod",
    "start:prod:indexer": "pnpm --filter indexer run start:prod",
    "start:prod:worker": "pnpm --filter worker run start:prod",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:cov": "turbo run test:cov",
    "test:e2e": "turbo run test:e2e",
    "test:unit": "jest --testPathPattern='unit'",
    "test:integration": "jest --testPathPattern='integration' --runInBand",
    "test:api": "pnpm --filter api run test",
    "test:indexer": "pnpm --filter indexer run test",
    "test:worker": "pnpm --filter worker run test",
    "test:websocket": "pnpm --filter websocket run test",
    "test:common": "pnpm --filter @hodlfun/common run test",
    "test:database": "pnpm --filter @hodlfun/database run test",
    "test:redis": "pnpm --filter @hodlfun/redis run test",
    "prisma:generate": "pnpm --filter @hodlfun/database run prisma:generate",
    "prisma:migrate:dev": "pnpm --filter @hodlfun/database run prisma:migrate:dev",
    "prisma:migrate:deploy": "pnpm --filter @hodlfun/database run prisma:migrate:deploy",
    "prisma:migrate:test": "DATABASE_URL=$DATABASE_URL_TEST pnpm --filter @hodlfun/database run prisma:migrate:deploy"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.0",
    "@nestjs/testing": "^10.3.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "jest-mock-extended": "^3.0.5",
    "prettier": "^3.1.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "turbo": "^1.11.0",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.11.0"
}
