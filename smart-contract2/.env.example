# ============================================================================
# DEPLOYMENT CONFIGURATION FOR PUSH CHAIN TESTNET
# ============================================================================
# IMPORTANT: Copy this file to .env and fill in your actual values
# NEVER commit .env file to git!
# ============================================================================

# ============================================================================
# DEPLOYMENT ACCOUNT
# ============================================================================
# Your test account private key (TESTNET ONLY!)
# Format: 0x123abc... (with or without 0x prefix)
PRIVATE_KEY=0x

# ============================================================================
# PUSH CHAIN NETWORK CONFIGURATION
# ============================================================================
# RPC URL for Push Chain Testnet
RPC_URL=https://evm.donut.rpc.push.org/

# Alternative RPC URL (for fallback)
RPC_URL_ALT=https://evm.rpc-testnet-donut-node2.push.org/

# ============================================================================
# CONTRACT CONFIGURATION
# ============================================================================
# PUSH Token (Wrapped Native) address on Push Chain Testnet
# Note: Update this with actual PUSH token address
WPUSH_ADDRESS=0x8c0F8f803d4E10a6d8FE62925BD4FaF7C6Fd0c27

# Uniswap V3 Factory address (set to zero until deployed)
DEX_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000

# ============================================================================
# BLOCKSCOUT VERIFICATION
# ============================================================================
# BlockScout API Key (usually "blockscout" for public explorers)
ETHERSCAN_API_KEY=blockscout

# BlockScout API URL for Push Chain Testnet
BLOCKSCOUT_API_URL=https://donut.push.network/api

# ============================================================================
# DEPLOYMENT PARAMETERS (in PUSH - 18 decimals)
# ============================================================================
# Fee for deploying a new token (in PUSH)
DEPLOY_FEE=0.01

# Fee for listing on DEX (in PUSH)
LISTING_FEE=0.1

# Virtual Native Reserve (in PUSH)
VIRTUAL_NATIVE=1

# Virtual Token Reserve (in tokens)
VIRTUAL_TOKEN=50000000

# Market cap threshold for graduation to DEX (in PUSH)
GRADUATION_MARKET_CAP=1000000

# Fee denominator and numerator (fee = numerator / denominator)
FEE_DENOMINATOR=100
FEE_NUMERATOR=1  # 1% = 1/100

# Uniswap V3 fee tier (500 = 0.05%, 3000 = 0.30%, 10000 = 1.00%)
DEX_FEE=3000

# ============================================================================
# SECURITY NOTES
# ============================================================================
# 1. NEVER use a real account with significant funds
# 2. NEVER share or commit your private key
# 3. NEVER share this .env file with anyone
# 4. Always verify contract addresses before interaction
# 5. Test with small amounts first
# 6. Keep backups of deployment addresses and ABIs
# ============================================================================
